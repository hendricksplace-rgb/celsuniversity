# Copy to .env.local and fill in. Never commit real values.

# Public (safe in the browser): Supabase project URL and publishable key
NEXT_PUBLIC_SUPABASE_URL=https://pbpnhsgygwqxnkklhyuz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public site URL, used for auth email redirects
# Public address (src/lib/site.ts). Vercel: https://nuevo.celstv.com now, https://celstv.com on switch day.
# next.config.ts copies it into NEXT_PUBLIC_SITE_URL for the browser.
SITE_URL=http://localhost:3000
# "true" only once celstv.com serves this app: removes noindex, serves robots.txt and sitemap.xml.
SITE_INDEXABLE=false

# --- Only for scripts/migrate-base44 (never expose to the browser) ---
SUPABASE_SECRET_KEY=
