          "id": "1",
          "title": "Grammar",
          "subtitle": "Greetings, Introductions, and 'To Be'",
          "exercises": [
            {
              "id": 1,
              "type": "choose_text_from_audio",
              "content": {
                "options": [
                  {
                    "text": "I am a student.",
                    "correct": true
                  },
                  {
                    "text": "I are a student.",
                    "correct": false
                  },
                  {
                    "text": "I is a student.",
                    "correct": false
                  }
                ],
                "examples": [
                  "I am Carla.",
                  "You are my friend.",
                  "He is happy."
                ],
                "description": "We use 'to be' to describe people and things.\n\nExamples:"
              },
              "audioFile": ""
            },
            {
              "id": 2,
              "type": "choose_text_from_audio",
              "content": {
                "options": [
                  {
                    "text": "Is.",
                    "correct": false
                  },
                  {
                    "text": "Am.",
                    "correct": false
                  },
                  {
                    "text": "Are.",
                    "correct": true
                  }
                ],
                "examples": [],
                "description": "Let's see how 'to be' works with different subjects:\n\n**Subject** | **Verb** | **Example**\nI | am | I am Alex.\nYou | are | You are welcome.\nHe | is | He is my teacher.\nShe | is | She is very kind.\nIt | is | It is cold today.\nWe | are | We are ready.\nThey | are | They are students.",
                "questionText": "What's the correct verb for 'they'?"
              },
              "audioFile": ""
            },
            {
              "id": 3,
              "type": "choose_text_from_audio",
              "content": {
                "options": [
                  {
                    "text": "I're tired",
                    "correct": false
                  },
                  {
                    "text": "I'm tired",
                    "correct": true
                  },
                  {
                    "text": "I is tired",
                    "correct": false
                  }
                ],
                "sections": [
                  {
                    "name": "'To be' is **irregular**, which means it doesn't follow standard grammar rules. That's why it changes depending on the subject.",
                    "examples": []
                  },
                  {
                    "name": "We also use **contractions** in everyday speech:",
                    "examples": [
                      "I am → I'm",
                      "You are → You're",
                      "He is → He's",
                      "She is → She's",
                      "We are → We're",
                      "They are → They're"
                    ]
                  },
                  {
                    "name": "Examples:",
                    "examples": [
                      "I'm ready.",
                      "She's my friend.",
                      "We're happy to be here."
                    ]
                  }
                ],
                "questionText": "Which of these is a correct contraction?"
              },
              "audioFile": ""
            },
            {
              "id": 4,
              "type": "listen_only",
              "content": {
                "title": "Reading",
                "sentences": [
                  {
