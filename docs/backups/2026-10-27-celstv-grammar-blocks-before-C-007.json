          "exercises": [
            {
              "id": 1,
              "type": "choose_text_from_audio",
              "content": {
                "options": [
                  {
                    "text": "My dad is happy.",
                    "correct": true
                  },
                  {
                    "text": "My dad are happy.",
                    "correct": false
                  },
                  {
                    "text": "My dad am happy.",
                    "correct": false
                  }
                ],
                "examples": [
                  "My dad is happy.",
                  "My mom is kind.",
                  "My brothers are funny."
                ],
                "description": "This week we continue practicing the **verb \"to be\"** and now combine it with **family vocabulary** and **descriptive adjectives**. You'll learn how to talk about who people are and describe them.",
                "questionText": "Which sentence is correct?"
              },
              "audioFile": ""
            },
            {
              "id": 2,
              "type": "choose_text_from_audio",
              "content": {
                "options": [
                  {
                    "text": "This are my aunt.",
                    "correct": false
                  },
                  {
                    "text": "This is my aunt.",
                    "correct": true
                  },
                  {
                    "text": "This am my aunt.",
                    "correct": false
                  }
                ],
                "examples": [],
                "description": "Let's use \"to be\" with **family nouns** and adjectives:\n\n**Subject** | **Verb** | **Example Sentence**\nMy mom | is | My mom is sweet.\nMy brothers | are | My brothers are funny.\nThis | is | This is my sister.\nThey | are | They are my grandparents.\nWe | are | We are a big family.",
                "questionText": "Which is correct?"
              },
              "audioFile": ""
            },
            {
              "id": 3,
              "type": "choose_text_from_audio",
              "content": {
                "options": [
                  {
                    "text": "These are my grandparents.",
                    "correct": true
                  },
                  {
                    "text": "This is my grandparents.",
                    "correct": false
                  },
                  {
                    "text": "This are my grandparents.",
                    "correct": false
                  }
                ],
                "sections": [
                  {
                    "name": "Use **\"this is\"** when introducing one person:",
                    "examples": [
                      "This is my brother.",
                      "This is my cousin."
                    ]
                  },
                  {
                    "name": "Use **\"these are\"** for more than one:",
                    "examples": [
                      "These are my parents.",
                      "These are my uncles."
                    ]
                  },
                  {
                    "name": "Also, remember:",
                    "examples": [
                      "She is my grandma. → She's my grandma.",
                      "They are my cousins. → They're my cousins."
                    ]
                  }
                ],
                "questionText": "Which sentence introduces more than one person?"
              },
              "audioFile": ""
            },
